# Sanuvia Engineering Review Harness — production environment.
#
# This file is the systemd EnvironmentFile. deploy.sh copies it to
#   /etc/sanuvia/sanuvia.env
# on first provisioning; edit that copy (not this template) on the server.
# Format is KEY=value, one per line, no surrounding quotes, no `export`.

# ─── Network ────────────────────────────────────────────────────────────────
# Bind address. Keep 127.0.0.1 so ONLY the local reverse proxy (Caddy) can reach
# the app. Caddy terminates HTTPS for buyafraction.com and forwards here.
# Set 0.0.0.0 ONLY if you deliberately want to expose the app directly (then the
# firewall — not the app — must restrict access). Not recommended.
SANUVIA_HOST=127.0.0.1

# Port the harness listens on (localhost). Caddy proxies 443 -> this port.
SANUVIA_PORT=8000

# ─── Persistence ────────────────────────────────────────────────────────────
# Backend for reasoning state:
#   sqlite  — durable; REQUIRED in production. Survives restarts.
#   memory  — ephemeral, per-process. Do not use in production.
SANUVIA_BACKEND=sqlite

# SQLite database base path. Each Test Case gets its own file derived from this
# path. Must live on persistent storage owned by the service user.
SANUVIA_DB_PATH=/var/lib/sanuvia/sanuvia.db

# Directory for saved Review Datasets / Test Case definitions (durable).
# Reasoning state is regenerated deterministically by rerunning the saved
# sequences, so only the definitions need to persist here.
SANUVIA_TESTCASE_DIR=/var/lib/sanuvia/testcases

# ─── Determinism ────────────────────────────────────────────────────────────
# Pin the hash seed so every rendered artifact (trace, graph, report, review
# package) is byte-identical across restarts and machines. Do NOT change.
# (The systemd unit also sets this; keep them consistent.)
PYTHONHASHSEED=0
