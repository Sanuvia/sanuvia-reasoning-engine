# Copy to .env and adjust as needed; docker compose reads it automatically.

# Port the dashboard is published on (host side).
SANUVIA_PORT=8000

# Persistence backend for the review session:
#   memory  — ephemeral, per-process (default; nothing to persist)
#   sqlite  — durable; the database is stored at SANUVIA_DB_PATH on the volume
SANUVIA_BACKEND=memory

# SQLite database path inside the container (only used when SANUVIA_BACKEND=sqlite).
SANUVIA_DB_PATH=/data/sanuvia.db

# Directory for saved Test Case definitions (durable across restarts).
# Leave unset for in-memory (saves last only for the process lifetime).
SANUVIA_TESTCASE_DIR=/data/testcases
