# Sanuvia Reasoning Engine — example environment.
#
# Copy to `.env` (local) or to the systemd EnvironmentFile on a server, then edit.
# Format is KEY=value, one per line, no surrounding quotes, no `export`.
#
# SAFETY: this file contains PLACEHOLDER values only. Never commit real
# credentials, tokens, API keys, private IP addresses, or hostnames here — put
# those only in the un-tracked `.env` / deployment secret store. The engine core
# has zero secrets of its own; every value below is non-sensitive configuration.

# ─── Network ─────────────────────────────────────────────────────────────────
# Bind address. Keep 127.0.0.1 so ONLY a local reverse proxy can reach the app;
# the proxy terminates HTTPS and forwards here. Use 0.0.0.0 only when you
# deliberately expose the app directly and a firewall restricts access.
SANUVIA_HOST=127.0.0.1

# Local port the app listens on (the reverse proxy forwards 443 -> this port).
SANUVIA_PORT=8000

# ─── Persistence ─────────────────────────────────────────────────────────────
# Backend for reasoning state:
#   sqlite  — durable; recommended in production. Survives restarts.
#   memory  — ephemeral, per-process. For local experiments only.
SANUVIA_BACKEND=sqlite

# SQLite database base path. Must live on persistent storage writable by the
# service account. Replace with your own path.
SANUVIA_DB_PATH=/var/lib/sanuvia/sanuvia.db

# Directory for saved Test Case / Review Dataset definitions (durable). Reasoning
# state is regenerated deterministically by rerunning the saved sequences.
SANUVIA_TESTCASE_DIR=/var/lib/sanuvia/testcases

# ─── Determinism ─────────────────────────────────────────────────────────────
# Pin the hash seed so every rendered artifact (trace, graph, report, review
# package) is byte-identical across restarts and machines. Do NOT change.
PYTHONHASHSEED=0
